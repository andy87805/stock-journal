# Fastfile for StockJournal 的每週 OTA build。
#
# 前提：
# - 呼叫此 lane 之前，CI 已經在 ios/ 目錄跑過 `xcodegen generate`，
#   所以 ../ios/StockJournal.xcodeproj 這時已經存在（不是 checked-in 檔案）。
# - FASTLANE_SESSION 環境變數已經設定：fastlane 會自動讀取這個環境變數
#   來還原一組已登入的 Apple Developer session，不需要互動式輸入 Apple ID
#   密碼或 2FA。這裡不需要額外呼叫任何 action 去讀它，fastlane 內部的
#   Spaceship 會自己抓 ENV["FASTLANE_SESSION"]。
#   session 是用 `fastlane spaceauth -u <apple id>` 產生的，細節見 SETUP.md。
# - APPLE_ID、DEVICE_UDID 環境變數也已設定。

default_platform(:ios)

XCODEPROJ = "../ios/StockJournal.xcodeproj"
SCHEME = "StockJournal"
OUTPUT_DIR = "output"
IPA_NAME = "StockJournal.ipa"

platform :ios do
  desc "Get/refresh a free-tier development signing identity + provisioning profile, build, output .ipa"
  lane :build_and_publish do
    apple_id = ENV["APPLE_ID"]
    device_udid = ENV["DEVICE_UDID"]

    UI.user_error!("APPLE_ID 環境變數未設定") if apple_id.nil? || apple_id.empty?
    UI.user_error!("DEVICE_UDID 環境變數未設定") if device_udid.nil? || device_udid.empty?

    # 免費 Apple ID 帳號可用的開發用簽章身分（development certificate）。
    # cert 會重用既有的，過期或不存在才建立新的。
    cert(
      username: apple_id,
      development: true
    )

    # sigh 產生/更新一份綁定單一裝置（DEVICE_UDID）的 development provisioning profile。
    # 免費帳號沒有 App Store distribution 資格，只能用 development export method
    # 裝到自己註冊過 UDID 的裝置上（就是這個 workflow 產生的 OTA ipa 的用途）。
    sigh(
      username: apple_id,
      development: true,
      force: true,
      app_identifier: "com.andy878005.stockjournal",
      device_ids: [device_udid]
    )

    # 用 XcodeGen 產生的專案 build + export .ipa。
    # export_method development 對應上面的 development profile。
    gym(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "development",
      output_directory: OUTPUT_DIR,
      output_name: IPA_NAME,
      clean: true
    )

    UI.success("Built #{OUTPUT_DIR}/#{IPA_NAME}")
  end
end
