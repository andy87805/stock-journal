rules_version = '2';

// 單人個人專案的規則。PWA 放在公開網址（GitHub Pages）上，任何人都拿得到
// web/firebase-config.js 裡的專案設定，所以「只要求已登入」是不夠的——任何人
// 都能自己註冊/匿名登入然後讀走交易資料。這裡把讀寫權限綁死在唯一那一個帳號的 UID。
//
// Python 同步腳本走 Firebase Admin SDK + 服務帳戶金鑰，Admin SDK 完全繞過
// Security Rules，不受這裡限制，所以不需要為它開任何權限。
//
// 設定方式：在 Firebase Console → Authentication → Users 建立自己的帳號後，
// 把該列顯示的 User UID 填進下面的 OWNER_UID，然後重新部署：
//   firebase deploy --only firestore:rules
// 沒填之前一律拒絕（預設安全），登入後會讀不到任何資料。
service cloud.firestore {
  match /databases/{database}/documents {

    function ownerOnly() {
      let OWNER_UID = 'czOCfZWUr5WunUdv5UCpJ9zRPef1';
      return request.auth != null && request.auth.uid == OWNER_UID;
    }

    // 新增 collection 時一定要同步加這裡：Firestore 對沒有 match 到的路徑一律拒絕，
    // 前端會收到 permission-denied 而不是空資料，看起來像同步壞掉。
    match /positions/{positionId} {
      allow read, write: if ownerOnly();
    }

    match /realized/{realizedId} {
      allow read, write: if ownerOnly();
    }

    match /lots/{lotId} {
      allow read, write: if ownerOnly();
    }

    match /options/{optionId} {
      allow read, write: if ownerOnly();
    }

    match /symbols/{symbolId} {
      allow read, write: if ownerOnly();
    }

    match /settings/{settingId} {
      allow read, write: if ownerOnly();
    }

    match /fx/{pair} {
      allow read, write: if ownerOnly();
    }

    match /trades/{tradeId} {
      allow read, write: if ownerOnly();
    }

    match /dividends/{dividendId} {
      allow read, write: if ownerOnly();
    }

    match /calendarEvents/{eventId} {
      allow read, write: if ownerOnly();
    }

    match /quotes/{quoteId} {
      allow read, write: if ownerOnly();
    }

    match /syncMeta/{broker} {
      allow read, write: if ownerOnly();
    }
  }
}
