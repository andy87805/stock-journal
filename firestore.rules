rules_version = '2';

// 這是單人個人專案的規則，刻意寫得很簡單：
// - 唯一會用到這組規則的 client 是 iOS App 自己的匿名登入 (anonymous auth) session
// - Python 同步腳本用 Firebase Admin SDK + 服務帳戶金鑰寫入，Admin SDK 完全繞過
//   Security Rules，不受這裡的規則限制
// 所以「只要求已登入」就足夠，不需要依 UID 做細緻的 per-user 隔離。
// 這不是給多人/公開產品用的規則設計，複製到其他專案前請重新評估。
service cloud.firestore {
  match /databases/{database}/documents {

    match /trades/{tradeId} {
      allow read, write: if request.auth != null;
    }

    match /dividends/{dividendId} {
      allow read, write: if request.auth != null;
    }

    match /calendarEvents/{eventId} {
      allow read, write: if request.auth != null;
    }

    match /syncMeta/{broker} {
      allow read, write: if request.auth != null;
    }
  }
}
